#!/bin/sh

set -u

patch_dir=/usr/share/dms-shell-local-patches
mode=${1:---apply}
failed=0

case "$mode" in
    --apply|--check)
        ;;
    *)
        echo "Usage: $0 [--apply|--check]" >&2
        exit 2
        ;;
esac

log() {
    printf '%s\n' "dms-shell-local-patches: $*"
}

has_markers() {
    target=$1
    marker_one=$2
    marker_two=$3

    /usr/bin/grep -Fq "$marker_one" "$target" || return 1
    [ -z "$marker_two" ] || /usr/bin/grep -Fq "$marker_two" "$target"
}

handle_patch() {
    name=$1
    target=$2
    patch_file=$3
    marker_one=$4
    marker_two=$5

    if [ ! -f "$target" ]; then
        log "ERROR: $name target is missing: $target"
        failed=1
        return
    fi

    if has_markers "$target" "$marker_one" "$marker_two"; then
        log "applied: $name"
        return
    fi

    if ! /usr/bin/patch --dry-run --silent --forward --batch \
        --directory=/ --strip=1 < "$patch_file"; then
        log "ERROR: $name is incompatible with the installed dms-shell version"
        failed=1
        return
    fi

    if [ "$mode" = "--check" ]; then
        log "pending: $name"
        failed=1
        return
    fi

    if /usr/bin/patch --silent --forward --batch \
        --directory=/ --strip=1 < "$patch_file"; then
        log "newly applied: $name"
    else
        log "ERROR: failed while applying $name"
        failed=1
    fi
}

if [ ! -d "$patch_dir" ]; then
    log "ERROR: patch data directory is missing: $patch_dir"
    exit 1
fi

handle_patch \
    "segmented button outer-corner geometry" \
    "/usr/share/quickshell/dms/Widgets/DankButtonGroup.qml" \
    "$patch_dir/0001-segmented-button-corners.patch" \
    "topLeftRadius: visualFirst ? Theme.cornerRadius" \
    "topRightRadius: visualLast ? Theme.cornerRadius"

handle_patch \
    "animated DMS bar hide on fullscreen" \
    "/usr/share/quickshell/dms/Modules/DankBar/DankBarWindow.qml" \
    "$patch_dir/0002-niri-fullscreen-bar-animation.patch" \
    "readonly property bool hideForFullscreen:" \
    "duration: Math.max(Theme.shortDuration, 180)"

handle_patch \
    "lock screen password Ctrl+A select all" \
    "/usr/share/quickshell/dms/Modules/Lock/LockScreenContent.qml" \
    "$patch_dir/0003-lock-screen-select-all.patch" \
    "property bool allSelected: false" \
    "selectAll();"

handle_patch \
    "lock screen selection highlight alignment" \
    "/usr/share/quickshell/dms/Modules/Lock/LockScreenContent.qml" \
    "$patch_dir/0004-lock-screen-selection-alignment.patch" \
    "// Short passwords are left-aligned, so the highlight starts at the text item origin." \
    "" 

handle_patch \
    "niri session environment import warning" \
    "/usr/bin/niri-session" \
    "$patch_dir/0005-niri-session-import-environment.patch" \
    "XDG_SESSION_CLASS:+XDG_SESSION_CLASS" \
    ""

handle_patch \
    "niri Qt environment propagation" \
    "/usr/bin/niri-session" \
    "$patch_dir/0006-niri-session-qt-environment.patch" \
    'QT_QPA_PLATFORMTHEME:+QT_QPA_PLATFORMTHEME' \
    'unset-environment WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP NIRI_SOCKET \'

handle_patch \
    "niri Qt environment defaults" \
    "/usr/bin/niri-session" \
    "$patch_dir/0009-niri-session-qt-environment-defaults.patch" \
    ': "${QT_QPA_PLATFORMTHEME:=gtk3}"' \
    'export QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME QT_QPA_PLATFORMTHEME_QT6'

handle_patch \
    "DMS Qt colors XDG data path" \
    "/usr/share/quickshell/dms/scripts/qt.sh" \
    "$patch_dir/0007-qt-colors-xdg-data-path.patch" \
    'XDG_DATA_HOME:-$HOME/.local/share' \
    ""

handle_patch \
    "DMS Qt colors configuration newlines" \
    "/usr/share/quickshell/dms/scripts/qt.sh" \
    "$patch_dir/0008-qt-colors-config-newlines.patch" \
    "printf '[Appearance]\\ncustom_palette=true\\ncolor_scheme_path=%s\\n'" \
    ""

if [ "$failed" -ne 0 ]; then
    log "one or more patches need manual review; DMS was not restarted"
    exit 1
fi

if [ "$mode" = "--apply" ]; then
    log "all patches are present; restart DMS or log in again to load changed QML"
else
    log "all managed patches are present"
fi
