package() {
    install -Dm644 "$srcdir/shell.qml" \
        "$pkgdir/usr/share/quickshell/dms-material-transition/shell.qml"
    install -Dm755 "$srcdir/dms-material-transition" \
        "$pkgdir/usr/bin/dms-material-transition"
    install -Dm755 "$srcdir/dms-material-transition-configure" \
        "$pkgdir/usr/bin/dms-material-transition-configure"
    install -Dm755 "$srcdir/prepare-niri" \
        "$pkgdir/usr/lib/dms-material-transition/prepare-niri"
    install -Dm644 "$srcdir/20-dms-material-transition.conf" \
        "$pkgdir/usr/lib/systemd/user/niri.service.d/20-dms-material-transition.conf"

    install -Dm644 "$srcdir/0001-greeter-material-exit.patch" \
        "$pkgdir/usr/share/dms-material-transition/0001-greeter-material-exit.patch"
    install -Dm755 "$srcdir/dms-material-transition-patch-greeter" \
        "$pkgdir/usr/lib/dms-material-transition/patch-greeter"
    install -Dm644 "$srcdir/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
