#!/bin/sh

set -u

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
niri_config="$config_home/niri/config.kdl"
generated_config="$config_home/niri/startup-transition.kdl"
power_config=/etc/niri-dms-extreme-power.conf

[ -r "$niri_config" ] || exit 0
grep -Fq 'include optional=true "startup-transition.kdl"' "$niri_config" || exit 0

PANEL_OUTPUT=eDP-1
PERFORMANCE_MODE=2560x1600@165.004
BALANCED_MODE=2560x1600@60.002
POWER_SAVER_MODE=2560x1600@60.002

[ ! -r "$power_config" ] || . "$power_config"

profile=$(tlpctl get 2>/dev/null || printf '%s' balanced)
case "$profile" in
    performance) mode=$PERFORMANCE_MODE ;;
    power-saver) mode=$POWER_SAVER_MODE ;;
    *) mode=$BALANCED_MODE ;;
esac

mkdir -p "$(dirname "$generated_config")"
temporary="$generated_config.tmp.$$"
umask 077
if ! {
    printf '%s\n' '// Generated by dms-material-transition at niri startup.'
    printf 'output "%s" {\n' "$PANEL_OUTPUT"
    printf '    mode "%s"\n' "$mode"
    printf '%s\n' '}'
} >"$temporary"; then
    exit 1
fi

mv -f "$temporary" "$generated_config"
