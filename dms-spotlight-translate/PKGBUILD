# Maintainer: Steven <steven@localhost>

pkgname=dms-spotlight-translate
pkgver=1.0.0
pkgrel=1
pkgdesc="Automatic Chinese-English translation provider for DMS Spotlight"
arch=('any')
url="https://github.com/alcxyz/DankTranslate"
license=('MIT')
depends=('dms-shell>=1.4.0' 'translate-shell')
source=(
    'plugin.json'
    'SpotlightTranslate.qml'
    'SpotlightTranslateSettings.qml'
    'README.md'
    'LICENSE'
)
sha256sums=('f677d58a93c2074146973ca5469e8a55ba8a114b6f985b9d33d70b7851fec11b'
            'ef2eb872370546e28bd6e44d734bd0ea9f666cffab5812e4f8a08eda1a67196f'
            '29016251f3850168c4539a44be757af53e9e9684f88c3ac41adf9b01ab401f9a'
            'c4b4da20f6b0c332dfc5451a925b1ba4cfdb3749f5edcda6297676d5c7946506'
            '45c620d1cb04d093f7378c915c92d25e738f00a7f9445cb10a249508d90b0929')

package() {
    local plugin_dir="$pkgdir/etc/xdg/quickshell/dms-plugins/spotlightTranslate"

    install -Dm644 "$srcdir/plugin.json" "$plugin_dir/plugin.json"
    install -Dm644 "$srcdir/SpotlightTranslate.qml" "$plugin_dir/SpotlightTranslate.qml"
    install -Dm644 "$srcdir/SpotlightTranslateSettings.qml" "$plugin_dir/SpotlightTranslateSettings.qml"
    install -Dm644 "$srcdir/README.md" "$plugin_dir/README.md"
    install -Dm644 "$srcdir/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
}
