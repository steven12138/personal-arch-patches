+    function getSunTimeline(date, points = 96) {
+        if (!location) {
+            return null;
+        }
+        const lat = location.latitude;
+        const lon = location.longitude;
+        const day = new Date(date);
+        const year = day.getFullYear();
+        const month = day.getMonth();
+        const dayOfMonth = day.getDate();
+        const timeline = [];
+
+        for (let i = 0; i <= points; i++) {
+            const minuteOfDay = i / points * 24 * 60;
+            const sample = new Date(year, month, dayOfMonth, 0, minuteOfDay, 0, 0);
+            const pos = SunCalc.getPosition(sample, lat, lon);
+            timeline.push({
+                h: i / points,
+                v: Math.max(-1, Math.min(1, Math.sin(pos.altitude)))
+            });
+        }
+
+        return timeline;
+    }
+
+    function getSunTimelinePosition(date) {
+        if (!location) {
+            return null;
+        }
+        const value = new Date(date);
+        const pos = SunCalc.getPosition(value, location.latitude, location.longitude);
+        const seconds = value.getHours() * 3600 + value.getMinutes() * 60 + value.getSeconds();
+        return {
+            h: seconds / 86400,
+            v: Math.max(-1, Math.min(1, Math.sin(pos.altitude)))
+        };
+    }
