# Maintainer: Steven <steven@localhost>
pkgname=dms-legion-control
pkgver=1.0.1
pkgrel=1
pkgdesc="DMS widget for Lenovo Legion sensors and guarded platform controls"
arch=('any')
url='https://github.com/johnfanv2/LenovoLegionLinux'
license=('MIT')
depends=('dms-shell>=1.5.0' 'polkit' 'bash')
optdepends=('lenovo-legion-linux-dkms: exposes Legion EC controls')
source=('plugin.json' 'LegionControl.qml' 'LegionControlSettings.qml' 'legion-dmsctl' 'README.md' 'LICENSE')
sha256sums=('6b183f4cb44aa342e1f6d9590c1180c6762afd495f3798ecf2b984194d4d5ae3'
            '4a76622903084c3d0abe97814756e64095299ae1d93808055464bafccec88b17'
            '193a61a9695b32d22a00f961a2cbfa00bac8ba83c0a5ca7b9db52031243ded0f'
            'b9976c0088c355ba47f42cec04d8afc096512e5ff1521db9f74ddb70d9bee9c4'
            'd28407f642d3c9c8e9c0244cbaa8fc6e427adb1a86e79187247113db76772d88'
            'a79ae887ebaad33e05fc37b616553c688feccb1be177f8b5012d71af5f8af1cd')

package() {
    local plugin_dir="$pkgdir/etc/xdg/quickshell/dms-plugins/legionControl"
    install -Dm644 plugin.json "$plugin_dir/plugin.json"
    install -Dm644 LegionControl.qml "$plugin_dir/LegionControl.qml"
    install -Dm644 LegionControlSettings.qml "$plugin_dir/LegionControlSettings.qml"
    install -Dm755 legion-dmsctl "$pkgdir/usr/bin/legion-dmsctl"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
