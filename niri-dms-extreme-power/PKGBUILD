package() {
    install -Dm644 "$srcdir/99-extreme-powersave.conf" \
        "$pkgdir/etc/tlp.d/99-extreme-powersave.conf"
    install -Dm644 "$srcdir/niri-dms-extreme-power.conf" \
        "$pkgdir/etc/niri-dms-extreme-power.conf"

    install -Dm755 "$srcdir/niri-power-refresh" \
        "$pkgdir/usr/bin/niri-power-refresh"
    install -Dm755 "$srcdir/niri-dms-power-system" \
        "$pkgdir/usr/lib/niri-dms-extreme-power/apply-system-profile"
    install -Dm755 "$srcdir/prepare-niri-gpu" \
        "$pkgdir/usr/lib/niri-dms-extreme-power/prepare-niri-gpu"
    install -Dm644 "$srcdir/30-extreme-power-gpu.conf" \
        "$pkgdir/usr/lib/systemd/user/niri.service.d/30-extreme-power-gpu.conf"

    install -Dm644 "$srcdir/niri-dms-extreme-power.service" \
        "$pkgdir/usr/lib/systemd/system/niri-dms-extreme-power.service"
    install -Dm644 "$srcdir/99-niri-dms-extreme-power.rules" \
        "$pkgdir/usr/lib/udev/rules.d/99-niri-dms-extreme-power.rules"
    install -Dm644 "$srcdir/niri-dms-extreme-power.desktop" \
        "$pkgdir/etc/xdg/autostart/niri-dms-extreme-power.desktop"

    install -Dm644 "$srcdir/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
