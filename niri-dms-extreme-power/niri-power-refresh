#!/bin/sh
set -u

# The package installs a global XDG autostart entry. Exit immediately in KDE
# and every other desktop so this integration remains strictly niri-specific.
case ":${XDG_CURRENT_DESKTOP:-}:" in
    *:niri:*) ;;
    *) exit 0 ;;
esac

system_config=/etc/niri-dms-extreme-power.conf
user_config="${XDG_CONFIG_HOME:-$HOME/.config}/niri-dms-extreme-power.conf"

[ ! -r "$system_config" ] || . "$system_config"
[ ! -r "$user_config" ] || . "$user_config"

: "${PANEL_OUTPUT:=eDP-1}"
: "${PERFORMANCE_MODE:=2560x1600@165.004}"
: "${BALANCED_MODE:=2560x1600@60.002}"
: "${POWER_SAVER_MODE:=2560x1600@60.002}"
: "${POWER_SAVER_BRIGHTNESS:=20%}"
: "${PERFORMANCE_FALLBACK_BRIGHTNESS:=35%}"
: "${MANAGE_NVIDIA_GPU:=1}"
: "${NIRI_IGNORE_NVIDIA_GPU:=1}"
: "${NVIDIA_DRM_DEVICE:=/dev/dri/by-path/pci-0000:01:00.0-render}"

runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
exec 9>"$runtime_dir/niri-power-refresh.lock"
flock -n 9 || exit 0

last_profile=""
brightness_state="$runtime_dir/niri-power-refresh.brightness"
niri_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
niri_config="$niri_config_dir/config.kdl"
gpu_config="$niri_config_dir/dms/extreme-power-gpu.kdl"
gpu_include='include optional=true "dms/extreme-power-gpu.kdl"'

ensure_gpu_include() {
    [ "$MANAGE_NVIDIA_GPU" = 1 ] || return 0
    [ -r "$niri_config" ] || return 1
    grep -Fqx "$gpu_include" "$niri_config" && return 0

    config_temp="$niri_config.$$"
    if cp -p "$niri_config" "$config_temp" &&
            printf '\n// Managed by niri-dms-extreme-power.\n%s\n' \
                "$gpu_include" >>"$config_temp" &&
            niri validate -c "$config_temp" >/dev/null 2>&1; then
        mv -f "$config_temp" "$niri_config"
        return 0
    fi
    rm -f "$config_temp"
    return 1
}

write_gpu_profile() {
    [ "$MANAGE_NVIDIA_GPU" = 1 ] || return 0
    ensure_gpu_include || return 1
    mkdir -p "${gpu_config%/*}" || return 1

    gpu_temp="$gpu_config.$$"
    umask 077
    if [ "$NIRI_IGNORE_NVIDIA_GPU" = 1 ]; then
        {
            printf '%s\n' '// Generated by niri-dms-extreme-power.'
            printf '%s\n' 'debug {'
            printf '    ignore-drm-device "%s"\n' "$NVIDIA_DRM_DEVICE"
            printf '%s\n' '}'
        } >"$gpu_temp" || return 1
    else
        printf '%s\n' '// Generated by niri-dms-extreme-power; NVIDIA explicitly enabled.' \
            >"$gpu_temp" || return 1
    fi

    if [ -r "$gpu_config" ] && cmp -s "$gpu_temp" "$gpu_config"; then
        rm -f "$gpu_temp"
        return 0
    fi
    mv -f "$gpu_temp" "$gpu_config" || return 1
    niri msg action load-config-file >/dev/null 2>&1 || true
}

valid_brightness() {
    value=$1
    case "$value" in
        *%) percent=${value%\%} ;;
        *) return 1 ;;
    esac
    case "$percent" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$percent" -le 100 ]
}

save_brightness() {
    [ ! -s "$brightness_state" ] || return 0

    saved_brightness=$(brightnessctl --device=intel_backlight -m 2>/dev/null |
        cut -d, -f4)
    valid_brightness "$saved_brightness" || return 1

    brightness_temp="$brightness_state.$$"
    umask 077
    if printf '%s\n' "$saved_brightness" >"$brightness_temp"; then
        mv -f "$brightness_temp" "$brightness_state"
        return 0
    fi
    rm -f "$brightness_temp"
    return 1
}

restore_brightness() {
    if [ -r "$brightness_state" ]; then
        IFS= read -r saved_brightness <"$brightness_state" || saved_brightness=""
        if valid_brightness "$saved_brightness" &&
                brightnessctl --device=intel_backlight set "$saved_brightness" >/dev/null 2>&1; then
            rm -f "$brightness_state"
            return 0
        fi
    fi

    if brightnessctl --device=intel_backlight set \
            "$PERFORMANCE_FALLBACK_BRIGHTNESS" >/dev/null 2>&1; then
        rm -f "$brightness_state"
        return 0
    fi
    return 1
}

manage_background_services() {
    profile=$1
    [ "$profile" = "$last_profile" ] && return
    last_profile=$profile

    if [ "$profile" = "power-saver" ]; then
        systemctl --user stop \
            akonadi_control.service \
            app-org.kde.kalendarac@autostart.service \
            'app-org.kde.kclockd\x2dautostart@autostart.service' \
            app-org.kde.kdeconnect.daemon@autostart.service \
            'app-geoclue\x2ddemo\x2dagent@autostart.service' \
            'app-print\x2dapplet@autostart.service' \
            >/dev/null 2>&1 || true
    fi
}

apply_profile() {
    profile=$(tlpctl get 2>/dev/null) || return

    case "$profile" in
        performance)
            mode=$PERFORMANCE_MODE
            if [ "$last_profile" = "power-saver" ] || [ -e "$brightness_state" ]; then
                restore_brightness || true
            fi
            ;;
        balanced)
            mode=$BALANCED_MODE
            if [ "$last_profile" = "power-saver" ] || [ -e "$brightness_state" ]; then
                restore_brightness || true
            fi
            ;;
        power-saver)
            mode=$POWER_SAVER_MODE
            if [ "$last_profile" != "power-saver" ]; then
                save_brightness || true
            fi
            brightnessctl --device=intel_backlight set \
                "$POWER_SAVER_BRIGHTNESS" >/dev/null 2>&1
            ;;
        *)
            return
            ;;
    esac

    write_gpu_profile || true
    niri msg output "$PANEL_OUTPUT" mode "$mode" >/dev/null 2>&1
    manage_background_services "$profile"
}

apply_profile

while true; do
    stdbuf -oL -eL gdbus monitor --system \
        --dest org.freedesktop.UPower.PowerProfiles \
        --object-path /org/freedesktop/UPower/PowerProfiles 2>/dev/null 9>&- |
    while IFS= read -r event; do
        case "$event" in
            *ActiveProfile*)
                # tlp-pd applies profiles asynchronously; re-check once settled.
                apply_profile
                sleep 2
                apply_profile
                ;;
        esac
    done 9>&-

    sleep 1
    apply_profile
done
