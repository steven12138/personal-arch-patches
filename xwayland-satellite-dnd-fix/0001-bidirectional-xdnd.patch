@@ -0,0 +1,972 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Copy-only XDND bridge.  The state transitions follow the Xdnd v5 ordering
+// used by KWin's Xwayland data bridge, but this is an independent Rust
+// implementation for xwayland-satellite.
+
+use super::XState;
+use super::selection::Selection;
+use crate::server::selection::DndSourceUpdate;
+use crate::server::{ResolvedDndEvent, ServerState};
+use crate::xstate::RealConnection;
+use log::{debug, warn};
+use smithay_client_toolkit::data_device_manager::data_offer::DragOffer;
+use std::collections::HashMap;
+use std::rc::Rc;
+use wayland_client::protocol::wl_data_device_manager::DndAction;
+use xcb::{Xid, XidNew, x};
+
+pub(super) const XDND_VERSION: u32 = 5;
+
+#[derive(Debug)]
+struct ActiveDnd {
+    offer: DragOffer,
+    target: x::Window,
+    serial: u32,
+    version: u32,
+    mimes: Vec<(String, x::Atom)>,
+    data: HashMap<String, Vec<u8>>,
+    action: DndAction,
+    incr: Option<WaylandDndIncr>,
+    accepted: bool,
+    position_pending: bool,
+    cached_position: Option<(f64, f64)>,
+    drop_requested: bool,
+    dropped: bool,
+}
+
+#[derive(Debug)]
+struct WaylandDndIncr {
+    data: Vec<u8>,
+    start: usize,
+    property: x::Atom,
+    requestor: x::Window,
+    target: x::Atom,
+}
+
+#[derive(Default)]
+pub(super) struct DndBridge {
+    active: Option<ActiveDnd>,
+    x_to_wl: Option<XToWlDnd>,
+    pending_x_owner: Option<(x::Window, u32)>,
+}
+
+struct XToWlDnd {
+    selection: Rc<Selection>,
+    source: x::Window,
+    version: u32,
+    accepted_mime: Option<String>,
+    selected_action: DndAction,
+    dropped_on_x: bool,
+    dropped_on_wayland: bool,
+    mime_known: bool,
+    action_known: bool,
+    position_pending: bool,
+}
+
+impl DndBridge {
+    pub(super) fn new() -> Self {
+        Self::default()
+    }
+
+    fn send_message(state: &XState, target: x::Window, ty: x::Atom, data: [u32; 5]) {
+        let event = x::ClientMessageEvent::new(target, ty, x::ClientMessageData::Data32(data));
+        if let Err(error) = state.connection.send_and_check_request(&x::SendEvent {
+            propagate: false,
+            destination: x::SendEventDest::Window(target),
+            event_mask: x::EventMask::empty(),
+            event: &event,
+        }) {
+            warn!("failed to send XDND event to {target:?}: {error:?}");
+        }
+    }
+
+    fn send_message_as(
+        state: &XState,
+        destination: x::Window,
+        event_window: x::Window,
+        ty: x::Atom,
+        data: [u32; 5],
+    ) {
+        let event =
+            x::ClientMessageEvent::new(event_window, ty, x::ClientMessageData::Data32(data));
+        if let Err(error) = state.connection.send_and_check_request(&x::SendEvent {
+            propagate: false,
+            destination: x::SendEventDest::Window(destination),
+            event_mask: x::EventMask::empty(),
+            event: &event,
+        }) {
+            warn!("failed to send XDND proxy event to {destination:?}: {error:?}");
+        }
+    }
+
+    fn read_xdnd_types(state: &XState, source: x::Window, data: &[u32; 5]) -> Vec<x::Atom> {
+        if data[1] & 1 == 0 {
+            return data[2..5]
+                .iter()
+                .copied()
+                .filter(|atom| *atom != x::ATOM_NONE.resource_id())
+                .map(x::Atom::new)
+                .collect();
+        }
+        let cookie = state.connection.send_request(&x::GetProperty {
+            delete: false,
+            window: source,
+            property: state.atoms.xdnd_type_list,
+            r#type: x::ATOM_ATOM,
+            long_offset: 0,
+            long_length: u32::MAX,
+        });
+        state
+            .connection
+            .wait_for_reply(cookie)
+            .map(|reply| {
+                reply
+                    .value::<x::Atom>()
+                    .iter()
+                    .copied()
+                    .filter(|atom| {
+                        ![
+                            state.atoms.targets,
+                            state.atoms.multiple,
+                            state.atoms.save_targets,
+                            state.atoms.timestamp,
+                        ]
+                        .contains(atom)
+                    })
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+
+    fn start_x11_source(
+        &mut self,
+        state: &XState,
+        server: &mut ServerState<RealConnection>,
+        source: x::Window,
+        version: u32,
+        targets: Vec<x::Atom>,
+    ) {
+        if targets.is_empty() {
+            return;
+        }
+        let selection = Selection::from_targets(
+            state.connection.clone(),
+            state.wm_window,
+            state.atoms.xdnd_selection,
+            x::CURRENT_TIME,
+            state.atoms.incr,
+            &targets,
+        );
+        if !server.start_x11_dnd(&selection) {
+            debug!("could not start native drag for X11 source {source:?}");
+            return;
+        }
+        self.x_to_wl = Some(XToWlDnd {
+            selection,
+            source,
+            version,
+            accepted_mime: None,
+            selected_action: DndAction::None,
+            dropped_on_x: false,
+            dropped_on_wayland: false,
+            mime_known: false,
+            action_known: false,
+            position_pending: false,
+        });
+    }
+
+    fn begin_x11_owner(&mut self, state: &XState, owner: x::Window, timestamp: u32) {
+        if owner == x::Window::none() || owner == state.wm_window {
+            return;
+        }
+        self.pending_x_owner = Some((owner, timestamp));
+        let _ = state
+            .connection
+            .send_and_check_request(&x::ConvertSelection {
+                requestor: state.wm_window,
+                selection: state.atoms.xdnd_selection,
+                target: state.atoms.targets,
+                property: state.atoms.xdnd_targets,
+                time: timestamp,
+            });
+    }
+
+    fn targets_received(
+        &mut self,
+        state: &XState,
+        event: &x::SelectionNotifyEvent,
+        server: &mut ServerState<RealConnection>,
+    ) -> bool {
+        if event.selection() != state.atoms.xdnd_selection
+            || event.requestor() != state.wm_window
+            || event.target() != state.atoms.targets
+            || event.property() != state.atoms.xdnd_targets
+        {
+            return false;
+        }
+        let Some((owner, _)) = self.pending_x_owner.take() else {
+            return false;
+        };
+        let targets = state
+            .connection
+            .wait_for_reply(state.connection.send_request(&x::GetProperty {
+                delete: true,
+                window: state.wm_window,
+                property: state.atoms.xdnd_targets,
+                r#type: x::ATOM_ATOM,
+                long_offset: 0,
+                long_length: u32::MAX,
+            }))
+            .map(|reply| reply.value::<x::Atom>().to_vec())
+            .unwrap_or_default();
+        self.finish_x11_source(state, false);
+        self.start_x11_source(state, server, owner, XDND_VERSION, targets);
+        true
+    }
+
+    fn x11_action_atom(state: &XState, action: DndAction) -> x::Atom {
+        if action.contains(DndAction::Move) {
+            state.atoms.xdnd_action_move
+        } else if action.contains(DndAction::Copy) {
+            state.atoms.xdnd_action_copy
+        } else {
+            x::ATOM_NONE
+        }
+    }
+
+    fn send_x11_status(&self, state: &XState) {
+        let Some(dnd) = self.x_to_wl.as_ref() else {
+            return;
+        };
+        let accepted = dnd.accepted_mime.is_some()
+            && dnd
+                .selected_action
+                .intersects(DndAction::Copy | DndAction::Move);
+        Self::send_message_as(
+            state,
+            dnd.source,
+            dnd.source,
+            state.atoms.xdnd_status,
+            [
+                state.wm_window.resource_id(),
+                u32::from(accepted),
+                0,
+                0,
+                if accepted {
+                    Self::x11_action_atom(state, dnd.selected_action).resource_id()
+                } else {
+                    x::ATOM_NONE.resource_id()
+                },
+            ],
+        );
+    }
+
+    fn finish_x11_source(&mut self, state: &XState, success: bool) {
+        let Some(dnd) = self.x_to_wl.take() else {
+            return;
+        };
+        let reports_result = dnd.version >= 5;
+        Self::send_message_as(
+            state,
+            dnd.source,
+            dnd.source,
+            state.atoms.xdnd_finished,
+            [
+                state.wm_window.resource_id(),
+                u32::from(success && reports_result),
+                if success && reports_result {
+                    Self::x11_action_atom(state, dnd.selected_action).resource_id()
+                } else {
+                    x::ATOM_NONE.resource_id()
+                },
+                0,
+                0,
+            ],
+        );
+    }
+
+    fn x11_source_message(
+        &mut self,
+        state: &XState,
+        event: &x::ClientMessageEvent,
+        server: &mut ServerState<RealConnection>,
+    ) -> bool {
+        let x::ClientMessageData::Data32(data) = event.data() else {
+            return false;
+        };
+        if event.r#type() == state.atoms.xdnd_enter {
+            let source = x::Window::new(data[0]);
+            let version = (data[1] >> 24).min(XDND_VERSION);
+            if let Some(dnd) = self.x_to_wl.as_mut().filter(|dnd| dnd.source == source) {
+                dnd.version = version;
+            } else {
+                let targets = Self::read_xdnd_types(state, source, &data);
+                self.finish_x11_source(state, false);
+                self.start_x11_source(state, server, source, version, targets);
+            }
+            return true;
+        }
+        if event.r#type() == state.atoms.xdnd_position {
+            if let Some(dnd) = self
+                .x_to_wl
+                .as_mut()
+                .filter(|dnd| dnd.source.resource_id() == data[0])
+            {
+                dnd.position_pending = true;
+            }
+            if self
+                .x_to_wl
+                .as_ref()
+                .is_some_and(|dnd| dnd.position_pending && dnd.mime_known && dnd.action_known)
+            {
+                self.send_x11_status(state);
+                self.x_to_wl.as_mut().unwrap().position_pending = false;
+            }
+            return true;
+        }
+        if event.r#type() == state.atoms.xdnd_drop {
+            if let Some(dnd) = self
+                .x_to_wl
+                .as_mut()
+                .filter(|dnd| dnd.source.resource_id() == data[0])
+            {
+                dnd.dropped_on_x = true;
+            }
+            return true;
+        }
+        if event.r#type() == state.atoms.xdnd_leave {
+            if self
+                .x_to_wl
+                .as_ref()
+                .is_some_and(|dnd| dnd.source.resource_id() == data[0])
+            {
+                self.finish_x11_source(state, false);
+            }
+            return true;
+        }
+        false
+    }
+
+    fn update_x11_source(&mut self, state: &XState, update: DndSourceUpdate) {
+        let Some(dnd) = self.x_to_wl.as_mut() else {
+            return;
+        };
+        if let Some(mime) = update.accepted_mime {
+            dnd.accepted_mime = mime;
+            dnd.mime_known = true;
+        }
+        if let Some(action) = update.action {
+            dnd.selected_action = action;
+            dnd.action_known = true;
+        }
+        if update.dropped {
+            dnd.dropped_on_wayland = true;
+        }
+        let send_status = dnd.position_pending && dnd.mime_known && dnd.action_known;
+        if update.cancelled {
+            self.finish_x11_source(state, false);
+        } else if update.finished {
+            let success = dnd.dropped_on_x && dnd.dropped_on_wayland;
+            self.finish_x11_source(state, success);
+        } else if send_status {
+            self.send_x11_status(state);
+            self.x_to_wl.as_mut().unwrap().position_pending = false;
+        }
+    }
+
+    fn packed_coords(x: i16, y: i16) -> u32 {
+        (u32::from(x as u16) << 16) | u32::from(y as u16)
+    }
+
+    fn root_coords(state: &XState, target: x::Window, x: f64, y: f64) -> u32 {
+        let x = (x.round().clamp(i16::MIN as f64, i16::MAX as f64) as i16) as u16;
+        let y = (y.round().clamp(i16::MIN as f64, i16::MAX as f64) as i16) as u16;
+        let cookie = state.connection.send_request(&x::TranslateCoordinates {
+            src_window: target,
+            dst_window: state.root,
+            src_x: x as i16,
+            src_y: y as i16,
+        });
+        match state.connection.wait_for_reply(cookie) {
+            Ok(reply) => Self::packed_coords(reply.dst_x(), reply.dst_y()),
+            Err(error) => {
+                warn!("failed to translate XDND coordinates for {target:?}: {error:?}");
+                Self::packed_coords(x as i16, y as i16)
+            }
+        }
+    }
+
+    fn target_version(state: &XState, target: x::Window) -> Option<u32> {
+        let cookie = state.connection.send_request(&x::GetProperty {
+            delete: false,
+            window: target,
+            property: state.atoms.xdnd_aware,
+            r#type: x::ATOM_ATOM,
+            long_offset: 0,
+            long_length: 1,
+        });
+        state
+            .connection
+            .wait_for_reply(cookie)
+            .ok()?
+            .value::<u32>()
+            .first()
+            .copied()
+    }
+
+    fn release_selection(state: &XState) {
+        let owner = state
+            .connection
+            .wait_for_reply(state.connection.send_request(&x::GetSelectionOwner {
+                selection: state.atoms.xdnd_selection,
+            }))
+            .ok()
+            .map(|reply| reply.owner());
+        if owner != Some(state.wm_window) {
+            return;
+        }
+        let _ = state
+            .connection
+            .send_and_check_request(&x::SetSelectionOwner {
+                owner: x::Window::none(),
+                selection: state.atoms.xdnd_selection,
+                time: x::CURRENT_TIME,
+            });
+    }
+
+    fn claim_selection(state: &XState) -> bool {
+        if state
+            .connection
+            .send_and_check_request(&x::SetSelectionOwner {
+                owner: state.wm_window,
+                selection: state.atoms.xdnd_selection,
+                time: x::CURRENT_TIME,
+            })
+            .is_err()
+        {
+            return false;
+        }
+        state
+            .connection
+            .wait_for_reply(state.connection.send_request(&x::GetSelectionOwner {
+                selection: state.atoms.xdnd_selection,
+            }))
+            .is_ok_and(|reply| reply.owner() == state.wm_window)
+    }
+
+    fn clear_active(&mut self, state: &XState, send_leave: bool, finish: bool) {
+        let Some(active) = self.active.take() else {
+            return;
+        };
+        if send_leave && !active.dropped {
+            Self::send_message(
+                state,
+                active.target,
+                state.atoms.xdnd_leave,
+                [state.wm_window.resource_id(), 0, 0, 0, 0],
+            );
+        }
+        if finish {
+            active.offer.finish();
+        } else if !active.drop_requested {
+            active.offer.accept_mime_type(active.serial, None);
+        }
+        // SCTK destroys an offer before delivering leave when no Wayland drop
+        // occurred.  A dropped offer is deliberately retained by SCTK and is
+        // ours to destroy after the X target finishes or aborts.
+        if active.drop_requested {
+            active.offer.destroy();
+        }
+        Self::release_selection(state);
+    }
+
+    fn leave(&mut self, state: &XState) {
+        if self
+            .active
+            .as_ref()
+            .is_some_and(|active| active.drop_requested)
+        {
+            // A dropped Wayland offer remains valid until the X target sends
+            // XdndFinished and may still be asked for selection data.
+            return;
+        }
+        self.clear_active(state, true, false);
+    }
+
+    fn enter(&mut self, state: &XState, offer: DragOffer, target: x::Window, x: f64, y: f64) {
+        self.clear_active(state, true, false);
+
+        let mime_names = offer.with_mime_types(|mimes| mimes.to_vec());
+        if mime_names.is_empty() {
+            debug!("rejecting Wayland drag without MIME types for X11 target {target:?}");
+            offer.accept_mime_type(offer.serial, None);
+            return;
+        }
+
+        let Some(target_version) = Self::target_version(state, target) else {
+            debug!("rejecting drag for XDND-unaware X11 target {target:?}");
+            offer.accept_mime_type(offer.serial, None);
+            return;
+        };
+        let version = target_version.min(XDND_VERSION);
+        if version < 2 {
+            debug!("rejecting unsupported XDND v{version} target {target:?}");
+            offer.accept_mime_type(offer.serial, None);
+            return;
+        }
+
+        let supported = offer.source_actions & (DndAction::Copy | DndAction::Move);
+        let action = if supported.contains(DndAction::Copy) {
+            DndAction::Copy
+        } else if supported.contains(DndAction::Move) {
+            DndAction::Move
+        } else {
+            DndAction::Copy
+        };
+        offer.set_actions(DndAction::Copy | DndAction::Move, action);
+        let mimes: Vec<_> = mime_names
+            .into_iter()
+            .map(|mime| {
+                let atom = state
+                    .connection
+                    .wait_for_reply(state.connection.send_request(&x::InternAtom {
+                        only_if_exists: false,
+                        name: mime.as_bytes(),
+                    }))
+                    .expect("failed to intern DND MIME type")
+                    .atom();
+                (mime, atom)
+            })
+            .collect();
+        offer.accept_mime_type(offer.serial, Some(mimes[0].0.clone()));
+
+        if !Self::claim_selection(state) {
+            offer.accept_mime_type(offer.serial, None);
+            return;
+        }
+
+        if mimes.len() > 3 {
+            let atoms: Vec<_> = mimes.iter().map(|(_, atom)| *atom).collect();
+            let _ = state.connection.send_and_check_request(&x::ChangeProperty {
+                mode: x::PropMode::Replace,
+                window: state.wm_window,
+                property: state.atoms.xdnd_type_list,
+                r#type: x::ATOM_ATOM,
+                data: &atoms,
+            });
+        }
+        let mut advertised = [0; 3];
+        for (slot, (_, atom)) in advertised.iter_mut().zip(&mimes) {
+            *slot = atom.resource_id();
+        }
+        Self::send_message(
+            state,
+            target,
+            state.atoms.xdnd_enter,
+            [
+                state.wm_window.resource_id(),
+                version << 24 | u32::from(mimes.len() > 3),
+                advertised[0],
+                advertised[1],
+                advertised[2],
+            ],
+        );
+        self.active = Some(ActiveDnd {
+            serial: offer.serial,
+            offer,
+            target,
+            version,
+            mimes,
+            data: HashMap::new(),
+            action,
+            incr: None,
+            accepted: false,
+            position_pending: false,
+            cached_position: None,
+            drop_requested: false,
+            dropped: false,
+        });
+        self.motion(state, x, y);
+    }
+
+    fn send_position(&mut self, state: &XState, x: f64, y: f64) {
+        let Some(active) = self.active.as_mut() else {
+            return;
+        };
+        if active.position_pending {
+            active.cached_position = Some((x, y));
+            return;
+        }
+        Self::send_message(
+            state,
+            active.target,
+            state.atoms.xdnd_position,
+            [
+                state.wm_window.resource_id(),
+                0,
+                Self::root_coords(state, active.target, x, y),
+                0,
+                Self::x11_action_atom(state, active.action).resource_id(),
+            ],
+        );
+        active.position_pending = true;
+    }
+
+    fn motion(&mut self, state: &XState, x: f64, y: f64) {
+        if self
+            .active
+            .as_ref()
+            .is_some_and(|active| active.drop_requested)
+        {
+            return;
+        }
+        self.send_position(state, x, y);
+    }
+
+    fn perform_drop(&mut self, state: &XState) {
+        let Some(active) = self.active.as_mut() else {
+            return;
+        };
+        if active.position_pending || active.dropped {
+            return;
+        }
+        if !active.accepted {
+            self.clear_active(state, true, false);
+            return;
+        }
+        active.dropped = true;
+        Self::send_message(
+            state,
+            active.target,
+            state.atoms.xdnd_drop,
+            [state.wm_window.resource_id(), 0, 0, 0, 0],
+        );
+    }
+
+    fn drop(&mut self, state: &XState) {
+        let Some(active) = self.active.as_mut() else {
+            return;
+        };
+        active.drop_requested = true;
+        self.perform_drop(state);
+    }
+
+    fn selection_request(
+        &mut self,
+        state: &XState,
+        event: &x::SelectionRequestEvent,
+        server: &mut ServerState<RealConnection>,
+    ) -> bool {
+        if event.selection() != state.atoms.xdnd_selection {
+            return false;
+        }
+
+        if event.owner() != state.wm_window {
+            return false;
+        }
+
+        let property = if event.property() == x::ATOM_NONE {
+            event.target()
+        } else {
+            event.property()
+        };
+        let mut success = false;
+        if let Some(active) = self.active.as_mut() {
+            if event.target() == state.atoms.targets {
+                let mut atoms = vec![state.atoms.targets, state.atoms.timestamp];
+                atoms.extend(active.mimes.iter().map(|(_, atom)| *atom));
+                success = state
+                    .connection
+                    .send_and_check_request(&x::ChangeProperty {
+                        mode: x::PropMode::Replace,
+                        window: event.requestor(),
+                        property,
+                        r#type: x::ATOM_ATOM,
+                        data: &atoms,
+                    })
+                    .is_ok();
+            } else if event.target() == state.atoms.timestamp {
+                success = state
+                    .connection
+                    .send_and_check_request(&x::ChangeProperty {
+                        mode: x::PropMode::Replace,
+                        window: event.requestor(),
+                        property,
+                        r#type: x::ATOM_INTEGER,
+                        data: &[x::CURRENT_TIME],
+                    })
+                    .is_ok();
+            } else if let Some((mime, atom)) = active
+                .mimes
+                .iter()
+                .find(|(_, atom)| *atom == event.target())
+                .cloned()
+            {
+                active
+                    .offer
+                    .accept_mime_type(active.serial, Some(mime.clone()));
+                if !active.data.contains_key(&mime) {
+                    let data = server.receive_dnd_offer(&active.offer, mime.clone());
+                    active.data.insert(mime.clone(), data);
+                }
+                let data = active.data.get(&mime).cloned().unwrap_or_default();
+                if data.len() > state.max_req_bytes {
+                    let _ = state
+                        .connection
+                        .send_and_check_request(&x::ChangeWindowAttributes {
+                            window: event.requestor(),
+                            value_list: &[x::Cw::EventMask(x::EventMask::PROPERTY_CHANGE)],
+                        });
+                    success = state
+                        .connection
+                        .send_and_check_request(&x::ChangeProperty {
+                            mode: x::PropMode::Replace,
+                            window: event.requestor(),
+                            property,
+                            r#type: state.atoms.incr,
+                            data: &[data.len() as u32],
+                        })
+                        .is_ok();
+                    if success {
+                        active.incr = Some(WaylandDndIncr {
+                            data,
+                            start: 0,
+                            property,
+                            requestor: event.requestor(),
+                            target: atom,
+                        });
+                    }
+                } else {
+                    success = state
+                        .connection
+                        .send_and_check_request(&x::ChangeProperty {
+                            mode: x::PropMode::Replace,
+                            window: event.requestor(),
+                            property,
+                            r#type: atom,
+                            data: &data,
+                        })
+                        .is_ok();
+                }
+            }
+        }
+
+        let notify = x::SelectionNotifyEvent::new(
+            event.time(),
+            event.requestor(),
+            event.selection(),
+            event.target(),
+            if success { property } else { x::ATOM_NONE },
+        );
+        let _ = state.connection.send_and_check_request(&x::SendEvent {
+            propagate: false,
+            destination: x::SendEventDest::Window(event.requestor()),
+            event_mask: x::EventMask::empty(),
+            event: &notify,
+        });
+        true
+    }
+
+    fn continue_wayland_incr(&mut self, state: &XState, event: &x::PropertyNotifyEvent) -> bool {
+        let Some(incr) = self.active.as_mut().and_then(|active| active.incr.as_mut()) else {
+            return false;
+        };
+        if event.state() != x::Property::Delete
+            || event.window() != incr.requestor
+            || event.atom() != incr.property
+        {
+            return false;
+        }
+        let end = (incr.start + state.max_req_bytes).min(incr.data.len());
+        let chunk = &incr.data[incr.start..end];
+        let result = state.connection.send_and_check_request(&x::ChangeProperty {
+            mode: x::PropMode::Replace,
+            window: incr.requestor,
+            property: incr.property,
+            r#type: incr.target,
+            data: chunk,
+        });
+        if result.is_err() || chunk.is_empty() {
+            if let Some(active) = self.active.as_mut() {
+                active.incr = None;
+            }
+        } else {
+            incr.start = end;
+        }
+        true
+    }
+
+    fn client_message(&mut self, state: &XState, event: &x::ClientMessageEvent) -> bool {
+        let x::ClientMessageData::Data32(data) = event.data() else {
+            return false;
+        };
+        if event.r#type() == state.atoms.xdnd_status {
+            let Some(active) = self.active.as_mut() else {
+                return true;
+            };
+            if data[0] != active.target.resource_id() {
+                return false;
+            }
+            active.position_pending = false;
+            let action = if data[4] == state.atoms.xdnd_action_move.resource_id() {
+                DndAction::Move
+            } else if data[4] == state.atoms.xdnd_action_copy.resource_id() {
+                DndAction::Copy
+            } else {
+                DndAction::None
+            };
+            active.accepted = data[1] & 1 != 0 && action != DndAction::None;
+            if active.accepted {
+                active.action = action;
+                active
+                    .offer
+                    .set_actions(DndAction::Copy | DndAction::Move, action);
+                active
+                    .offer
+                    .accept_mime_type(active.serial, Some(active.mimes[0].0.clone()));
+            } else {
+                active.offer.accept_mime_type(active.serial, None);
+            }
+            let cached_position = active.cached_position.take();
+            let drop_requested = active.drop_requested;
+            if let Some((x, y)) = cached_position {
+                self.send_position(state, x, y);
+            } else if drop_requested {
+                self.perform_drop(state);
+            }
+            return true;
+        }
+        if event.r#type() == state.atoms.xdnd_finished {
+            let Some(active) = self.active.as_ref() else {
+                return true;
+            };
+            if data[0] != active.target.resource_id() {
+                return false;
+            }
+            let success = active.dropped && (active.version < 5 || data[1] & 1 != 0);
+            self.clear_active(state, false, success);
+            return true;
+        }
+        false
+    }
+
+    fn handle_xevent(
+        &mut self,
+        state: &XState,
+        event: &xcb::Event,
+        server: &mut ServerState<RealConnection>,
+    ) -> bool {
+        match event {
+            xcb::Event::XFixes(xcb::xfixes::Event::SelectionNotify(event))
+                if event.selection() == state.atoms.xdnd_selection =>
+            {
+                match event.subtype() {
+                    xcb::xfixes::SelectionEvent::SetSelectionOwner => {
+                        self.begin_x11_owner(state, event.owner(), event.timestamp());
+                    }
+                    xcb::xfixes::SelectionEvent::SelectionWindowDestroy
+                    | xcb::xfixes::SelectionEvent::SelectionClientClose => {
+                        self.pending_x_owner = None;
+                        self.finish_x11_source(state, false);
+                    }
+                }
+                true
+            }
+            xcb::Event::X(x::Event::PropertyNotify(event))
+                if event.state() == x::Property::Delete =>
+            {
+                self.continue_wayland_incr(state, event)
+            }
+            xcb::Event::X(x::Event::SelectionNotify(event))
+                if event.selection() == state.atoms.xdnd_selection =>
+            {
+                if self.targets_received(state, event, server) {
+                    return true;
+                }
+                if let Some(dnd) = self.x_to_wl.as_ref() {
+                    dnd.selection.handle_notify(event.target());
+                }
+                true
+            }
+            xcb::Event::X(x::Event::PropertyNotify(event))
+                if event.state() == x::Property::NewValue =>
+            {
+                self.x_to_wl
+                    .as_ref()
+                    .is_some_and(|dnd| dnd.selection.check_for_incr(event))
+            }
+            xcb::Event::X(x::Event::SelectionRequest(event)) => {
+                self.selection_request(state, event, server)
+            }
+            xcb::Event::X(x::Event::ClientMessage(event)) => {
+                self.x11_source_message(state, event, server) || self.client_message(state, event)
+            }
+            xcb::Event::X(x::Event::SelectionClear(event))
+                if event.selection() == state.atoms.xdnd_selection =>
+            {
+                if let Some(active) = self.active.take() {
+                    if active.drop_requested {
+                        active.offer.destroy();
+                    }
+                }
+                true
+            }
+            xcb::Event::X(x::Event::DestroyNotify(event))
+                if self
+                    .active
+                    .as_ref()
+                    .is_some_and(|active| active.target == event.window()) =>
+            {
+                self.clear_active(state, false, false);
+                true
+            }
+            _ => false,
+        }
+    }
+}
+
+impl XState {
+    pub(crate) fn handle_wayland_dnd(&mut self, event: ResolvedDndEvent) {
+        let mut dnd = std::mem::take(&mut self.dnd);
+        if dnd.x_to_wl.is_some() {
+            if let ResolvedDndEvent::Enter { offer, .. } = event {
+                // This is our own X11 source re-entering an Xwayland surface.
+                // Native targets are handled by the compositor; do not bridge
+                // the offer back into the same X server.
+                offer.accept_mime_type(offer.serial, None);
+            }
+            self.dnd = dnd;
+            return;
+        }
+        match event {
+            ResolvedDndEvent::Enter {
+                offer,
+                window,
+                x,
+                y,
+            } => dnd.enter(self, offer, window, x, y),
+            ResolvedDndEvent::Motion { x, y } => dnd.motion(self, x, y),
+            ResolvedDndEvent::Leave => dnd.leave(self),
+            ResolvedDndEvent::Drop => dnd.drop(self),
+        }
+        self.dnd = dnd;
+    }
+
+    pub(crate) fn handle_x11_dnd_update(&mut self, update: DndSourceUpdate) {
+        let mut dnd = std::mem::take(&mut self.dnd);
+        dnd.update_x11_source(self, update);
+        self.dnd = dnd;
+    }
+
+    pub(super) fn handle_dnd_xevent(
+        &mut self,
+        event: &xcb::Event,
+        server: &mut ServerState<RealConnection>,
+    ) -> bool {
+        let mut dnd = std::mem::take(&mut self.dnd);
+        let handled = dnd.handle_xevent(self, event, server);
+        self.dnd = dnd;
+        handled
+    }
+}
