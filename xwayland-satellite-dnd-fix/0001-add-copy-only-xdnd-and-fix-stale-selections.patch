diff --git a/src/xstate/dnd.rs b/src/xstate/dnd.rs
new file mode 100644
index 0000000..37ee5a2
--- /dev/null
+++ b/src/xstate/dnd.rs
@@ -0,0 +1,488 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Copy-only XDND bridge.  The state transitions follow the Xdnd v5 ordering
+// used by KWin's Xwayland data bridge, but this is an independent Rust
+// implementation for xwayland-satellite.
+
+use super::XState;
+use crate::server::{ResolvedDndEvent, ServerState};
+use crate::xstate::RealConnection;
+use log::{debug, warn};
+use smithay_client_toolkit::data_device_manager::data_offer::DragOffer;
+use wayland_client::protocol::wl_data_device_manager::DndAction;
+use xcb::{Xid, x};
+
+pub(super) const XDND_VERSION: u32 = 5;
+const URI_LIST: &str = "text/uri-list";
+
+#[derive(Debug)]
+struct ActiveDnd {
+    offer: DragOffer,
+    target: x::Window,
+    serial: u32,
+    version: u32,
+    mime_atom: x::Atom,
+    data: Option<Vec<u8>>,
+    accepted: bool,
+    position_pending: bool,
+    cached_position: Option<(f64, f64)>,
+    drop_requested: bool,
+    dropped: bool,
+}
+
+#[derive(Debug, Default)]
+pub(super) struct DndBridge {
+    active: Option<ActiveDnd>,
+}
+
+impl DndBridge {
+    pub(super) fn new() -> Self {
+        Self::default()
+    }
+
+    fn send_message(state: &XState, target: x::Window, ty: x::Atom, data: [u32; 5]) {
+        let event = x::ClientMessageEvent::new(target, ty, x::ClientMessageData::Data32(data));
+        if let Err(error) = state.connection.send_and_check_request(&x::SendEvent {
+            propagate: false,
+            destination: x::SendEventDest::Window(target),
+            event_mask: x::EventMask::empty(),
+            event: &event,
+        }) {
+            warn!("failed to send XDND event to {target:?}: {error:?}");
+        }
+    }
+
+    fn packed_coords(x: i16, y: i16) -> u32 {
+        (u32::from(x as u16) << 16) | u32::from(y as u16)
+    }
+
+    fn root_coords(state: &XState, target: x::Window, x: f64, y: f64) -> u32 {
+        let x = (x.round().clamp(i16::MIN as f64, i16::MAX as f64) as i16) as u16;
+        let y = (y.round().clamp(i16::MIN as f64, i16::MAX as f64) as i16) as u16;
+        let cookie = state.connection.send_request(&x::TranslateCoordinates {
+            src_window: target,
+            dst_window: state.root,
+            src_x: x as i16,
+            src_y: y as i16,
+        });
+        match state.connection.wait_for_reply(cookie) {
+            Ok(reply) => Self::packed_coords(reply.dst_x(), reply.dst_y()),
+            Err(error) => {
+                warn!("failed to translate XDND coordinates for {target:?}: {error:?}");
+                Self::packed_coords(x as i16, y as i16)
+            }
+        }
+    }
+
+    fn target_version(state: &XState, target: x::Window) -> Option<u32> {
+        let cookie = state.connection.send_request(&x::GetProperty {
+            delete: false,
+            window: target,
+            property: state.atoms.xdnd_aware,
+            r#type: x::ATOM_ATOM,
+            long_offset: 0,
+            long_length: 1,
+        });
+        state
+            .connection
+            .wait_for_reply(cookie)
+            .ok()?
+            .value::<u32>()
+            .first()
+            .copied()
+    }
+
+    fn release_selection(state: &XState) {
+        let owner = state
+            .connection
+            .wait_for_reply(state.connection.send_request(&x::GetSelectionOwner {
+                selection: state.atoms.xdnd_selection,
+            }))
+            .ok()
+            .map(|reply| reply.owner());
+        if owner != Some(state.wm_window) {
+            return;
+        }
+        let _ = state
+            .connection
+            .send_and_check_request(&x::SetSelectionOwner {
+                owner: x::Window::none(),
+                selection: state.atoms.xdnd_selection,
+                time: x::CURRENT_TIME,
+            });
+    }
+
+    fn claim_selection(state: &XState) -> bool {
+        if state
+            .connection
+            .send_and_check_request(&x::SetSelectionOwner {
+                owner: state.wm_window,
+                selection: state.atoms.xdnd_selection,
+                time: x::CURRENT_TIME,
+            })
+            .is_err()
+        {
+            return false;
+        }
+        state
+            .connection
+            .wait_for_reply(state.connection.send_request(&x::GetSelectionOwner {
+                selection: state.atoms.xdnd_selection,
+            }))
+            .is_ok_and(|reply| reply.owner() == state.wm_window)
+    }
+
+    fn clear_active(&mut self, state: &XState, send_leave: bool, finish: bool) {
+        let Some(active) = self.active.take() else {
+            return;
+        };
+        if send_leave && !active.dropped {
+            Self::send_message(
+                state,
+                active.target,
+                state.atoms.xdnd_leave,
+                [state.wm_window.resource_id(), 0, 0, 0, 0],
+            );
+        }
+        if finish {
+            active.offer.finish();
+        } else if !active.drop_requested {
+            active.offer.accept_mime_type(active.serial, None);
+        }
+        // SCTK destroys an offer before delivering leave when no Wayland drop
+        // occurred.  A dropped offer is deliberately retained by SCTK and is
+        // ours to destroy after the X target finishes or aborts.
+        if active.drop_requested {
+            active.offer.destroy();
+        }
+        Self::release_selection(state);
+    }
+
+    fn leave(&mut self, state: &XState) {
+        if self
+            .active
+            .as_ref()
+            .is_some_and(|active| active.drop_requested)
+        {
+            // A dropped Wayland offer remains valid until the X target sends
+            // XdndFinished and may still be asked for selection data.
+            return;
+        }
+        self.clear_active(state, true, false);
+    }
+
+    fn enter(&mut self, state: &XState, offer: DragOffer, target: x::Window, x: f64, y: f64) {
+        self.clear_active(state, true, false);
+
+        let has_uri_list = offer.with_mime_types(|mimes| mimes.iter().any(|m| m == URI_LIST));
+        if !has_uri_list {
+            debug!("rejecting non-file Wayland drag for X11 target {target:?}");
+            offer.accept_mime_type(offer.serial, None);
+            return;
+        }
+
+        let Some(target_version) = Self::target_version(state, target) else {
+            debug!("rejecting drag for XDND-unaware X11 target {target:?}");
+            offer.accept_mime_type(offer.serial, None);
+            return;
+        };
+        let version = target_version.min(XDND_VERSION);
+        if version < 2 {
+            debug!("rejecting unsupported XDND v{version} target {target:?}");
+            offer.accept_mime_type(offer.serial, None);
+            return;
+        }
+
+        offer.set_actions(DndAction::Copy, DndAction::Copy);
+        offer.accept_mime_type(offer.serial, Some(URI_LIST.to_string()));
+        let mime_atom = state
+            .connection
+            .wait_for_reply(state.connection.send_request(&x::InternAtom {
+                only_if_exists: false,
+                name: URI_LIST.as_bytes(),
+            }))
+            .expect("failed to intern text/uri-list")
+            .atom();
+
+        if !Self::claim_selection(state) {
+            offer.accept_mime_type(offer.serial, None);
+            return;
+        }
+
+        Self::send_message(
+            state,
+            target,
+            state.atoms.xdnd_enter,
+            [
+                state.wm_window.resource_id(),
+                version << 24,
+                mime_atom.resource_id(),
+                0,
+                0,
+            ],
+        );
+        self.active = Some(ActiveDnd {
+            serial: offer.serial,
+            offer,
+            target,
+            version,
+            mime_atom,
+            data: None,
+            accepted: false,
+            position_pending: false,
+            cached_position: None,
+            drop_requested: false,
+            dropped: false,
+        });
+        self.motion(state, x, y);
+    }
+
+    fn send_position(&mut self, state: &XState, x: f64, y: f64) {
+        let Some(active) = self.active.as_mut() else {
+            return;
+        };
+        if active.position_pending {
+            active.cached_position = Some((x, y));
+            return;
+        }
+        Self::send_message(
+            state,
+            active.target,
+            state.atoms.xdnd_position,
+            [
+                state.wm_window.resource_id(),
+                0,
+                Self::root_coords(state, active.target, x, y),
+                0,
+                state.atoms.xdnd_action_copy.resource_id(),
+            ],
+        );
+        active.position_pending = true;
+    }
+
+    fn motion(&mut self, state: &XState, x: f64, y: f64) {
+        if self
+            .active
+            .as_ref()
+            .is_some_and(|active| active.drop_requested)
+        {
+            return;
+        }
+        self.send_position(state, x, y);
+    }
+
+    fn perform_drop(&mut self, state: &XState) {
+        let Some(active) = self.active.as_mut() else {
+            return;
+        };
+        if active.position_pending || active.dropped {
+            return;
+        }
+        if !active.accepted {
+            self.clear_active(state, true, false);
+            return;
+        }
+        active.dropped = true;
+        Self::send_message(
+            state,
+            active.target,
+            state.atoms.xdnd_drop,
+            [state.wm_window.resource_id(), 0, 0, 0, 0],
+        );
+    }
+
+    fn drop(&mut self, state: &XState) {
+        let Some(active) = self.active.as_mut() else {
+            return;
+        };
+        active.drop_requested = true;
+        self.perform_drop(state);
+    }
+
+    fn selection_request(
+        &mut self,
+        state: &XState,
+        event: &x::SelectionRequestEvent,
+        server: &mut ServerState<RealConnection>,
+    ) -> bool {
+        if event.selection() != state.atoms.xdnd_selection {
+            return false;
+        }
+
+        if event.owner() != state.wm_window {
+            return false;
+        }
+
+        let property = if event.property() == x::ATOM_NONE {
+            event.target()
+        } else {
+            event.property()
+        };
+        let mut success = false;
+        if let Some(active) = self.active.as_mut() {
+            if event.target() == state.atoms.targets {
+                success = state
+                    .connection
+                    .send_and_check_request(&x::ChangeProperty {
+                        mode: x::PropMode::Replace,
+                        window: event.requestor(),
+                        property,
+                        r#type: x::ATOM_ATOM,
+                        data: &[state.atoms.targets, state.atoms.timestamp, active.mime_atom],
+                    })
+                    .is_ok();
+            } else if event.target() == state.atoms.timestamp {
+                success = state
+                    .connection
+                    .send_and_check_request(&x::ChangeProperty {
+                        mode: x::PropMode::Replace,
+                        window: event.requestor(),
+                        property,
+                        r#type: x::ATOM_INTEGER,
+                        data: &[x::CURRENT_TIME],
+                    })
+                    .is_ok();
+            } else if event.target() == active.mime_atom {
+                if active.data.is_none() {
+                    active.data =
+                        Some(server.receive_dnd_offer(&active.offer, URI_LIST.to_string()));
+                }
+                let data = active.data.as_deref().unwrap_or_default();
+                success = !data.is_empty()
+                    && state
+                        .connection
+                        .send_and_check_request(&x::ChangeProperty {
+                            mode: x::PropMode::Replace,
+                            window: event.requestor(),
+                            property,
+                            r#type: active.mime_atom,
+                            data,
+                        })
+                        .is_ok();
+            }
+        }
+
+        let notify = x::SelectionNotifyEvent::new(
+            event.time(),
+            event.requestor(),
+            event.selection(),
+            event.target(),
+            if success { property } else { x::ATOM_NONE },
+        );
+        let _ = state.connection.send_and_check_request(&x::SendEvent {
+            propagate: false,
+            destination: x::SendEventDest::Window(event.requestor()),
+            event_mask: x::EventMask::empty(),
+            event: &notify,
+        });
+        true
+    }
+
+    fn client_message(&mut self, state: &XState, event: &x::ClientMessageEvent) -> bool {
+        let x::ClientMessageData::Data32(data) = event.data() else {
+            return false;
+        };
+        if event.r#type() == state.atoms.xdnd_status {
+            let Some(active) = self.active.as_mut() else {
+                return true;
+            };
+            if data[0] != active.target.resource_id() {
+                return false;
+            }
+            active.position_pending = false;
+            active.accepted =
+                data[1] & 1 != 0 && data[4] == state.atoms.xdnd_action_copy.resource_id();
+            if active.accepted {
+                active.offer.set_actions(DndAction::Copy, DndAction::Copy);
+                active
+                    .offer
+                    .accept_mime_type(active.serial, Some(URI_LIST.to_string()));
+            } else {
+                active.offer.accept_mime_type(active.serial, None);
+            }
+            let cached_position = active.cached_position.take();
+            let drop_requested = active.drop_requested;
+            if let Some((x, y)) = cached_position {
+                self.send_position(state, x, y);
+            } else if drop_requested {
+                self.perform_drop(state);
+            }
+            return true;
+        }
+        if event.r#type() == state.atoms.xdnd_finished {
+            let Some(active) = self.active.as_ref() else {
+                return true;
+            };
+            if data[0] != active.target.resource_id() {
+                return false;
+            }
+            let success = active.dropped && (active.version < 5 || data[1] & 1 != 0);
+            self.clear_active(state, false, success);
+            return true;
+        }
+        false
+    }
+
+    fn handle_xevent(
+        &mut self,
+        state: &XState,
+        event: &xcb::Event,
+        server: &mut ServerState<RealConnection>,
+    ) -> bool {
+        match event {
+            xcb::Event::X(x::Event::SelectionRequest(event)) => {
+                self.selection_request(state, event, server)
+            }
+            xcb::Event::X(x::Event::ClientMessage(event)) => self.client_message(state, event),
+            xcb::Event::X(x::Event::SelectionClear(event))
+                if event.selection() == state.atoms.xdnd_selection =>
+            {
+                if let Some(active) = self.active.take() {
+                    if active.drop_requested {
+                        active.offer.destroy();
+                    }
+                }
+                true
+            }
+            xcb::Event::X(x::Event::DestroyNotify(event))
+                if self
+                    .active
+                    .as_ref()
+                    .is_some_and(|active| active.target == event.window()) =>
+            {
+                self.clear_active(state, false, false);
+                true
+            }
+            _ => false,
+        }
+    }
+}
+
+impl XState {
+    pub(crate) fn handle_wayland_dnd(&mut self, event: ResolvedDndEvent) {
+        let mut dnd = std::mem::take(&mut self.dnd);
+        match event {
+            ResolvedDndEvent::Enter {
+                offer,
+                window,
+                x,
+                y,
+            } => dnd.enter(self, offer, window, x, y),
+            ResolvedDndEvent::Motion { x, y } => dnd.motion(self, x, y),
+            ResolvedDndEvent::Leave => dnd.leave(self),
+            ResolvedDndEvent::Drop => dnd.drop(self),
+        }
+        self.dnd = dnd;
+    }
+
+    pub(super) fn handle_dnd_xevent(
+        &mut self,
+        event: &xcb::Event,
+        server: &mut ServerState<RealConnection>,
+    ) -> bool {
+        let mut dnd = std::mem::take(&mut self.dnd);
+        let handled = dnd.handle_xevent(self, event, server);
+        self.dnd = dnd;
+        handled
+    }
+}
