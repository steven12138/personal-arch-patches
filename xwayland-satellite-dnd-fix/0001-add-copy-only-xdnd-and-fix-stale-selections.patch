+#[test]
+fn wayland_file_drag_to_x11_copy() {
+    let mut f = Fixture::new();
+    let mut connection = Connection::new(&f.display);
+    let window = connection.new_window(connection.root, 30, 40, 200, 120, false);
+    connection.set_property(window, x::ATOM_ATOM, connection.atoms.xdnd_aware, &[5_u32]);
+    let surface = f.map_as_toplevel(&mut connection, window);
+
+    let uri_data = b"file:///home/steven/Documents/xdnd-test.png\r\n".to_vec();
+    f.testwl.create_drag_offer(
+        surface,
+        vec![testwl::PasteData {
+            mime_type: "text/uri-list".into(),
+            data: uri_data.clone(),
+        }],
+        4.0,
+        5.0,
+    );
+
+    let enter = connection.await_client_message(connection.atoms.xdnd_enter);
+    let x::ClientMessageData::Data32(enter_data) = enter.data() else {
+        panic!("XdndEnter did not use 32-bit data");
+    };
+    assert_eq!(enter.window(), window);
+    assert_eq!(enter_data[0], connection.wm_window.resource_id());
+    assert_eq!(enter_data[1] >> 24, 5);
+    assert_eq!(enter_data[2], connection.atoms.uri_list.resource_id());
+
+    let first_position = connection.await_client_message(connection.atoms.xdnd_position);
+    let x::ClientMessageData::Data32(first_position_data) = first_position.data() else {
+        panic!("XdndPosition did not use 32-bit data");
+    };
+    assert_eq!(first_position_data[0], connection.wm_window.resource_id());
+    assert_eq!(
+        first_position_data[4],
+        connection.atoms.xdnd_action_copy.resource_id()
+    );
+
+    // XDND permits only one Position/Status round trip at a time.  Queue two
+    // motions and a drop while the first Position is pending; only the newest
+    // position must be emitted after Status, and Drop must wait for its Status.
+    f.testwl.drag_motion(10.0, 11.0);
+    f.testwl.drag_motion(20.0, 21.0);
+    f.testwl.drag_drop();
+    std::thread::sleep(Duration::from_millis(50));
+
+    let status = x::ClientMessageEvent::new(
+        connection.wm_window,
+        connection.atoms.xdnd_status,
+        x::ClientMessageData::Data32([
+            window.resource_id(),
+            1,
+            0,
+            0,
+            connection.atoms.xdnd_action_copy.resource_id(),
+        ]),
+    );
+    connection.send_client_message_to(connection.wm_window, &status);
+    let cached_position = connection.await_client_message(connection.atoms.xdnd_position);
+    let x::ClientMessageData::Data32(cached_position_data) = cached_position.data() else {
+        panic!("cached XdndPosition did not use 32-bit data");
+    };
+    assert_ne!(cached_position_data[2], first_position_data[2]);
+
+    connection.send_client_message_to(connection.wm_window, &status);
+    let drop = connection.await_client_message(connection.atoms.xdnd_drop);
+    let x::ClientMessageData::Data32(drop_data) = drop.data() else {
+        panic!("XdndDrop did not use 32-bit data");
+    };
+    assert_eq!(drop_data[0], connection.wm_window.resource_id());
+
+    // A compositor leave after drop must not destroy the retained offer before
+    // the X target asks for XdndSelection data.
+    f.testwl.drag_leave();
+    connection
+        .send_and_check_request(&x::ConvertSelection {
+            requestor: window,
+            selection: connection.atoms.xdnd_selection,
+            target: connection.atoms.uri_list,
+            property: connection.atoms.uri_list,
+            time: x::CURRENT_TIME,
+        })
+        .unwrap();
+    f.testwl.dispatch();
+    let notify = connection.await_selection_notify();
+    assert_eq!(notify.property(), connection.atoms.uri_list);
+    let reply = connection.get_reply(&x::GetProperty {
+        delete: false,
+        window,
+        property: connection.atoms.uri_list,
+        r#type: connection.atoms.uri_list,
+        long_offset: 0,
+        long_length: uri_data.len() as u32,
+    });
+    assert_eq!(reply.value::<u8>(), uri_data);
+
+    let finished = x::ClientMessageEvent::new(
+        connection.wm_window,
+        connection.atoms.xdnd_finished,
+        x::ClientMessageData::Data32([
+            window.resource_id(),
+            1,
+            connection.atoms.xdnd_action_copy.resource_id(),
+            0,
+            0,
+        ]),
+    );
+    connection.send_client_message_to(connection.wm_window, &finished);
+    std::thread::sleep(Duration::from_millis(20));
+    f.testwl.dispatch();
+    let owner = connection.get_reply(&x::GetSelectionOwner {
+        selection: connection.atoms.xdnd_selection,
+    });
+    assert_eq!(owner.owner(), x::Window::none());
+}
