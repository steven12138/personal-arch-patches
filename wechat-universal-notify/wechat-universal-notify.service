[Unit]
Description=Native desktop notifications for WeChat Universal
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/wechat-universal-notify
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=graphical-session.target
