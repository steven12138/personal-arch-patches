# Maintainer: Steven <steven@localhost>

pkgname=niri-xwayland-dnd-fix
pkgver=26.04
pkgrel=1
pkgdesc='niri with external xwayland-satellite bidirectional drag-and-drop support'
arch=('x86_64')
url='https://github.com/niri-wm/niri'
license=('GPL-3.0-or-later')
depends=(
  cairo glib2 glibc libdisplay-info libgcc libinput libpipewire
  libxkbcommon mesa pango pixman seatd systemd-libs xdg-desktop-portal-impl
)
makedepends=('clang' 'git' 'rust')
optdepends=(
  'xwayland-satellite-dnd-fix: matching bidirectional X11/Wayland DND bridge'
  'xdg-desktop-portal-gnome: screencasting portal'
  'xdg-desktop-portal-gtk: file chooser portal'
)
provides=("niri=$pkgver" 'wayland-compositor')
conflicts=('niri')
_niri_commit=8ed0da44d974c32c6877d2f4630c314da0717ecb
_smithay_commit=ff5fa7df392cecfba049ffed55cdaa4e98a8e7ef
source=(
  "niri::git+https://github.com/niri-wm/niri.git#commit=$_niri_commit"
  "smithay::git+https://github.com/Smithay/smithay.git#commit=$_smithay_commit"
  '0001-mark-external-xwayland-client.patch'
  '0002-smithay-external-xwayland-dnd-focus.patch'
)
sha256sums=(
  'SKIP'
  'SKIP'
  '24537ec80c6c8ef0f19142585c01869a0a4a55e03ea88497c1c7322b3b2883b0'
  '011148ac6093d4fff0e8839b0e8f46bd1644b2c69dc3bfafca4efc5a90bdb8fa'
)

prepare() {
  patch -d smithay -Np1 -i "$srcdir/0002-smithay-external-xwayland-dnd-focus.patch"
  patch -d niri -Np1 -i "$srcdir/0001-mark-external-xwayland-client.patch"

  # Build against the exact Smithay checkout patched above. If niri changes
  # its dependency layout, these anchored substitutions fail instead of
  # silently building without the bridge half.
  sed -i \
    -e '/^git = "https:\/\/github.com\/Smithay\/smithay.git"$/d' \
    -e '/^rev = "ff5fa7df392cecfba049ffed55cdaa4e98a8e7ef"$/d' \
    niri/Cargo.toml
  sed -i \
    '/^\[workspace.dependencies.smithay\]$/a path = "../smithay"' \
    niri/Cargo.toml
  sed -i \
    '/^\[workspace.dependencies.smithay-drm-extras\]$/a path = "../smithay/smithay-drm-extras"' \
    niri/Cargo.toml
  cd niri
  cargo update -p smithay -p smithay-drm-extras
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd niri
  export NIRI_BUILD_COMMIT="${_niri_commit::7}"
  CFLAGS+=(' -ffat-lto-objects')
  cargo build --frozen --release --features default
  for shell in bash fish zsh; do
    cargo run --frozen --release --bin niri -- completions "$shell" > "$shell-completions"
  done
}

check() {
  cd niri
  export XDG_RUNTIME_DIR="$(mktemp -d)"
  export RAYON_NUM_THREADS=1
  cargo test --all --exclude niri-visual-tests --frozen
}

package() {
  cd niri
  install -vDm755 {target/release/niri,resources/niri-session} -t "$pkgdir/usr/bin/"
  install -vDm644 resources/niri{.service,-shutdown.target} -t "$pkgdir/usr/lib/systemd/user/"
  install -vDm644 resources/niri.desktop -t "$pkgdir/usr/share/wayland-sessions/"
  install -vDm644 resources/niri-portals.conf -t "$pkgdir/usr/share/xdg-desktop-portal/"
  install -vDm644 resources/default-config.kdl README.md -t "$pkgdir/usr/share/doc/niri/"
  install -vDm644 bash-completions "$pkgdir/usr/share/bash-completion/completions/niri"
  install -vDm644 fish-completions "$pkgdir/usr/share/fish/vendor_completions.d/niri.fish"
  install -vDm644 zsh-completions "$pkgdir/usr/share/zsh/site-functions/_niri"
}
