+    /// Create a pointer DnD grab which keeps delivering pointer motion to the
+    /// surface where the grab started while data-device focus follows the real
+    /// drop target. This is useful for external Xwayland implementations.
+    pub fn new_pointer_with_source_focus(
+        #[cfg(feature = "wayland_frontend")] dh: &DisplayHandle,
+        start_data: PointerGrabStartData<D>,
+        source: S,
+        seat: Seat<D>,
+    ) -> Self {
+        let mut grab = Self::new_pointer(
+            #[cfg(feature = "wayland_frontend")]
+            dh,
+            start_data,
+            source,
+            seat,
+        );
+        grab.keep_pointer_focus = true;
+        grab
+    }
